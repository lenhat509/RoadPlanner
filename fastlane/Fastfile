# Waystage release automation. Run `bundle exec fastlane lanes` for the list.
#
# Required environment for signing/upload lanes (store as CI secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 .p8)  — App Store Connect API key
#   MATCH_GIT_URL, MATCH_PASSWORD                              — fastlane match
#   WAYSTAGE_BUNDLE_ID, WAYSTAGE_TEAM_ID                         — app identity
require "json"
require "fileutils"

default_platform(:ios)

PROJECT = "Waystage.xcodeproj"
SCHEME = "Waystage"
SCREENSHOT_DEVICE = ENV.fetch("SCREENSHOT_DEVICE", "iPhone 16 Pro Max") # 6.9-inch display

platform :ios do
  before_all do
    Dir.chdir("..") { sh("xcodegen", "generate", "--quiet") }
  end

  desc "Runs app unit tests and UI tests on the simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV["IOS_SIMULATOR"],
      result_bundle: true,
      output_directory: "fastlane/test_output",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Captures App Store screenshots from the UI-test sandbox"
  lane :screenshots do
    result_path = File.expand_path("screenshots/Screenshots.xcresult", __dir__)
    output_path = File.expand_path("screenshots/en-US", __dir__)
    FileUtils.rm_rf(result_path)
    FileUtils.mkdir_p(output_path)
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: SCREENSHOT_DEVICE,
      only_testing: ["WaystageUITests/ScreenshotTests"],
      result_bundle_path: result_path,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
    sh("xcrun", "xcresulttool", "export", "attachments", "--path", result_path, "--output-path", output_path)
    rename_exported_screenshots(output_path)
  end

  desc "Builds, signs and uploads a TestFlight build"
  lane :beta do
    verify_release_configuration(require_gateway: false)
    api_key = asc_api_key
    setup_ci if is_ci
    bundle_id = ENV.fetch("WAYSTAGE_BUNDLE_ID")
    # MATCH_READONLY=false on the very first run creates the certificate and profile (no Mac needed).
    match(type: "appstore", app_identifier: bundle_id, readonly: ENV.fetch("MATCH_READONLY", is_ci.to_s) == "true", api_key: api_key)
    # Sign only the app target manually with the match profile (Swift package targets are not signed).
    update_code_signing_settings(
      path: PROJECT,
      targets: ["Waystage"],
      use_automatic_signing: false,
      team_id: ENV.fetch("WAYSTAGE_TEAM_ID"),
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_#{bundle_id}_appstore_profile-name")
    )
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Uploads metadata, screenshots and the latest build for App Review (does not submit by default)"
  lane :release do |options|
    verify_release_configuration(require_gateway: true)
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      app_rating_config_path: "fastlane/app_rating_config.json",
      submit_for_review: options[:submit] == true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  desc "Updates App Store metadata only"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "fastlane/metadata",
      app_rating_config_path: "fastlane/app_rating_config.json",
      force: true
    )
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
  end

  # Store builds must not ship in demo mode: the Google key must be configured. TestFlight builds
  # may run without the gateway (hotel rates and fuel averages then fall back to estimates).
  private_lane :verify_release_configuration do |options|
    secrets = File.expand_path("../Config/Secrets.xcconfig", __dir__)
    UI.user_error!("Config/Secrets.xcconfig is missing (copy Secrets.example.xcconfig)") unless File.exist?(secrets)
    content = File.read(secrets)
    required = %w[GOOGLE_MAPS_API_KEY WAYSTAGE_BUNDLE_ID WAYSTAGE_TEAM_ID]
    required += %w[WAYSTAGE_GATEWAY_URL WAYSTAGE_GATEWAY_TOKEN] if options[:require_gateway]
    required.each do |key|
      value = content[/^\s*#{key}\s*=\s*(\S.*)$/, 1].to_s.strip
      UI.user_error!("#{key} is not set in Config/Secrets.xcconfig") if value.empty? || value.include?("...")
    end
  end
end

# Gives exported attachments their test names (01-Plan.png, …) using the export manifest.
def rename_exported_screenshots(directory)
  manifest_path = File.join(directory, "manifest.json")
  return unless File.exist?(manifest_path)
  JSON.parse(File.read(manifest_path)).each do |test|
    Array(test["attachments"]).each do |attachment|
      exported = File.join(directory, attachment["exportedFileName"].to_s)
      name = attachment["suggestedHumanReadableName"].to_s.sub(/_\d+_[0-9A-F-]+(?=\.png$)/i, "")
      next unless File.exist?(exported) && !name.empty?
      FileUtils.mv(exported, File.join(directory, name.end_with?(".png") ? name : "#{name}.png"))
    end
  end
  FileUtils.rm_f(manifest_path)
end

# Waystage release automation. Run `bundle exec fastlane lanes` for the list.
#
# Required environment for signing/upload lanes (store as CI secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 .p8)  — App Store Connect API key
#   MATCH_GIT_URL, MATCH_PASSWORD                              — fastlane match
#   WAYSTAGE_BUNDLE_ID, WAYSTAGE_TEAM_ID                         — app identity
require "json"
require "fileutils"

default_platform(:ios)

PROJECT = "Waystage.xcodeproj"
SCHEME = "Waystage"
# A 6.9-inch iPhone, the size App Store Connect asks for (CI passes its newest Pro Max).
SCREENSHOT_DEVICE = ENV["SCREENSHOT_DEVICE"].to_s.empty? ? "iPhone 16 Pro Max" : ENV["SCREENSHOT_DEVICE"]

platform :ios do
  before_all do
    Dir.chdir("..") { sh("xcodegen", "generate", "--quiet") }
  end

  desc "Runs app unit tests and UI tests on the simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV["IOS_SIMULATOR"],
      result_bundle: true,
      output_directory: "fastlane/test_output",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  # Offline sandbox data (made-up places, simplified routes): for checking the design, never for
  # the App Store, whose screenshots come from the real app (see docs/APP_STORE_RELEASE.md).
  desc "Captures review screenshots (00-Home … 06-Preview) from the offline UI-test sandbox"
  lane :screenshots do
    result_path = File.expand_path("screenshots/Screenshots.xcresult", __dir__)
    output_path = File.expand_path("screenshots/en-US", __dir__)
    FileUtils.rm_rf(result_path)
    FileUtils.mkdir_p(output_path)
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: SCREENSHOT_DEVICE,
      # The dark-mode and intro captures are for design review (the Screenshots workflow).
      only_testing: ["WaystageUITests/ScreenshotTests/testCaptureAppStoreScreenshots"],
      result_bundle_path: result_path,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
    sh("xcrun", "xcresulttool", "export", "attachments", "--path", result_path, "--output-path", output_path)
    rename_exported_screenshots(output_path)
  end

  desc "Builds, signs and uploads a TestFlight build"
  lane :beta do
    verify_release_configuration(require_gateway: false)
    api_key = asc_api_key
    # MATCH_READONLY=false (the workflow's "create_certificates") lets the first run create the
    # certificate and profile, no Mac needed. Read it before setup_ci, which resets it to true.
    readonly = ENV.fetch("MATCH_READONLY", is_ci.to_s) == "true"
    setup_ci if is_ci
    bundle_id = ENV.fetch("WAYSTAGE_BUNDLE_ID")
    # MATCH_FORCE=true (the workflow's "refresh_profile") makes a new profile, e.g. after CarPlay
    # was turned on for the App ID.
    force = ENV["MATCH_FORCE"] == "true"
    match(type: "appstore", app_identifier: bundle_id, readonly: readonly && !force, force: force, api_key: api_key)
    verify_profile_has_carplay(bundle_id)
    # Sign only the app target manually with the match profile (Swift package targets are not signed).
    update_code_signing_settings(
      path: PROJECT,
      targets: ["Waystage"],
      use_automatic_signing: false,
      team_id: ENV.fetch("WAYSTAGE_TEAM_ID"),
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_#{bundle_id}_appstore_profile-name")
    )
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Uploads the listing, review notes and age rating to App Store Connect; with submit (the workflow's submit_for_review) also submits the version's newest build for review"
  lane :release do |options|
    # No build happens here: the app that goes to the store is the TestFlight build from `beta`,
    # which checks its own configuration. Screenshots are taken on a real iPhone with real Google
    # data and uploaded in App Store Connect by hand, so this lane leaves them alone.
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_version: marketing_version,
      skip_binary_upload: true,
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      app_rating_config_path: "fastlane/app_rating_config.json",
      # Selects the newest build of this version (waiting until Apple has processed it) and
      # submits it; the encryption answer comes from Info.plist (ITSAppUsesNonExemptEncryption).
      submit_for_review: options[:submit] == true || ENV["SUBMIT_FOR_REVIEW"] == "true",
      # Released as soon as Apple approves it, as every version so far.
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end

  desc "Updates App Store metadata only"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_version: marketing_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "fastlane/metadata",
      app_rating_config_path: "fastlane/app_rating_config.json",
      force: true
    )
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
  end

  # Builds must not ship in demo mode: the Google key must be configured. The gateway is optional
  # (without it, hotel rates and missing fuel prices are clearly marked estimates).
  private_lane :verify_release_configuration do |options|
    secrets = File.expand_path("../Config/Secrets.xcconfig", __dir__)
    UI.user_error!("Config/Secrets.xcconfig is missing (the Release workflow writes it from the repository's secrets)") unless File.exist?(secrets)
    content = File.read(secrets)
    required = %w[GOOGLE_MAPS_API_KEY WAYSTAGE_BUNDLE_ID WAYSTAGE_TEAM_ID]
    required += %w[WAYSTAGE_GATEWAY_URL WAYSTAGE_GATEWAY_TOKEN] if options[:require_gateway]
    missing = required.select do |key|
      value = content[/^[ \t]*#{key}[ \t]*=[ \t]*(\S.*)$/, 1].to_s.strip
      value.empty? || value.include?("...")
    end
    unless missing.empty?
      UI.user_error!("Not set: #{missing.join(", ")}. Add them in GitHub under Settings → Secrets and variables → " \
                     "Actions: WAYSTAGE_BUNDLE_ID and WAYSTAGE_TEAM_ID on the Variables tab, the others on the " \
                     "Secrets tab (see docs/API_KEYS.md).")
    end
  end
end

# The app's version (MARKETING_VERSION in project.yml). The App Store version is set to it, so the
# builds uploaded by `beta` (e.g. 1.0.0) can be chosen for review.
def marketing_version
  File.read(File.expand_path("../project.yml", __dir__), encoding: "UTF-8")[/MARKETING_VERSION:\s*"?([0-9.]+)"?/, 1]
end

# Gives exported attachments their test names (01-Plan.png, …) using the export manifest.
def rename_exported_screenshots(directory)
  manifest_path = File.join(directory, "manifest.json")
  return unless File.exist?(manifest_path)
  JSON.parse(File.read(manifest_path)).each do |test|
    Array(test["attachments"]).each do |attachment|
      exported = File.join(directory, attachment["exportedFileName"].to_s)
      name = attachment["suggestedHumanReadableName"].to_s.sub(/_\d+_[0-9A-F-]+(?=\.png$)/i, "")
      next unless File.exist?(exported) && !name.empty?
      FileUtils.mv(exported, File.join(directory, name.end_with?(".png") ? name : "#{name}.png"))
    end
  end
  FileUtils.rm_f(manifest_path)
end

# The app asks for the CarPlay navigation entitlement (App/Waystage.entitlements), so the profile
# must include it, or the export fails with a much less helpful message.
def verify_profile_has_carplay(bundle_id)
  path = ENV["sigh_#{bundle_id}_appstore_profile-path"]
  return if path.nil? || !File.exist?(path)
  profile = `security cms -D -i "#{path}" 2>/dev/null`
  return if profile.include?("com.apple.developer.carplay-maps")
  UI.user_error!(
    "The provisioning profile doesn't include CarPlay yet. In the Apple Developer portal, open " \
    "Certificates, IDs & Profiles > Identifiers > #{bundle_id}, turn on CarPlay Navigation (listed " \
    "once Apple has granted it to your account) and save. Then run the Release workflow again with " \
    "\"refresh_profile\" ticked."
  )
end

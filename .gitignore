# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.ipa
*.dSYM.zip
*.xcresult
# Generated by XcodeGen (regenerate with `make project`)
*.xcodeproj/
*.xcworkspace/
!Packages/**/*.xcworkspace/
# Swift Package Manager
.build/
.swiftpm/
Packages/CadenceKit/.build/
# Secrets — never commit real keys
Config/Secrets.xcconfig
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
*.p8
*.mobileprovision
*.cer
# Node
node_modules/
coverage/
dist/
.env
# Test logs: keep the history file, ignore bulky per-run raw output older runs can be regenerated
test-logs/raw/

# Gateway test reports (regenerated by every run)
Backend/gateway/test-results/

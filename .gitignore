# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.ipa
*.dSYM.zip
*.xcresult
# Generated by XcodeGen (regenerate with `make project`)
*.xcodeproj/
*.xcworkspace/
!Packages/**/*.xcworkspace/
# Swift Package Manager
.build/
.swiftpm/
Packages/WaystageKit/.build/
# Secrets — never commit real keys
Config/Secrets.xcconfig
fastlane/report.xml
# App Review contact details are personal: enter them in App Store Connect (or keep them local)
fastlane/metadata/review_information/email_address.txt
fastlane/metadata/review_information/phone_number.txt
fastlane/metadata/review_information/first_name.txt
fastlane/metadata/review_information/last_name.txt
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
*.p8
*.mobileprovision
*.cer
# Node
node_modules/
coverage/
dist/
.env
# Test logs: keep the history file, ignore bulky per-run raw output older runs can be regenerated
test-logs/raw/

# Gateway test reports (regenerated by every run)
Backend/gateway/test-results/

# Website build output (scripts/build_site.py)
_site/

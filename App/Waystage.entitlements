<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay navigation app, granted by Apple. The App ID must have it enabled and the
	     provisioning profile must include it (see docs/CARPLAY.md). -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>

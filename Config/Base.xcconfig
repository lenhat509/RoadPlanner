// Shared build settings. Keys and IDs come from Secrets.xcconfig, which is git-ignored and never
// committed: on GitHub the Release workflow writes it from the repository's Actions secrets and
// variables on its temporary build machine; on your own Mac, copy Secrets.example.xcconfig.
// Without a Google key the app runs in demo mode.

GOOGLE_MAPS_API_KEY =
WAYSTAGE_BUNDLE_ID = com.example.waystage
WAYSTAGE_TEAM_ID =
// xcconfig treats "//" as a comment: write URLs as https:/$()/host
WAYSTAGE_GATEWAY_URL =
WAYSTAGE_GATEWAY_TOKEN =
// Named in Google's navigation terms dialog: the legal name on the Google Maps Platform account.
WAYSTAGE_COMPANY_NAME = Waystage

#include? "Secrets.xcconfig"

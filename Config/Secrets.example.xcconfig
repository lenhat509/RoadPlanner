// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// See docs/API_KEYS.md for how to create and restrict these keys.

// Your Apple bundle ID and team (Xcode → Signing & Capabilities).
CADENCE_BUNDLE_ID = com.yourcompany.cadence
CADENCE_TEAM_ID = ABCDE12345

// Google Maps Platform key restricted to iOS apps with the bundle ID above, and to:
// Maps SDK for iOS, Routes API, Places API (New).
GOOGLE_MAPS_API_KEY = AIza...

// Cadence gateway (Backend/gateway) for Expedia rates and EIA fuel averages.
// Note the $() trick: xcconfig would treat "//" as a comment.
CADENCE_GATEWAY_URL = https:/$()/cadence-gateway-xyz-uc.a.run.app
CADENCE_GATEWAY_TOKEN = replace-with-a-long-random-token

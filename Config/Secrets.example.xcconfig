// Only for building on your own Mac: copy to Config/Secrets.xcconfig (git-ignored, never
// committed) and fill in. Builds on GitHub don't use this: the Release workflow takes the same
// values from the repository's Actions secrets and variables. See docs/API_KEYS.md.

// Your Apple bundle ID and team (Xcode → Signing & Capabilities).
WAYSTAGE_BUNDLE_ID = com.yourcompany.waystage
WAYSTAGE_TEAM_ID = ABCDE12345

// Google Maps Platform key restricted to iOS apps with the bundle ID above, and to:
// Maps SDK for iOS, Routes API, Places API (New).
GOOGLE_MAPS_API_KEY = AIza...

// Waystage gateway (Backend/gateway) for Expedia rates and EIA fuel averages.
// Note the $() trick: xcconfig would treat "//" as a comment.
WAYSTAGE_GATEWAY_URL = https:/$()/waystage-gateway-xyz-uc.a.run.app
WAYSTAGE_GATEWAY_TOKEN = replace-with-a-long-random-token

# Copy to .env for local runs (never commit real values).
PORT=8080
LOG_LEVEL=info
# Comma-separated; must match CADENCE_GATEWAY_TOKEN in the app's Secrets.xcconfig. ≥ 16 chars each.
APP_TOKENS=replace-with-a-long-random-token
# Expedia Rapid partner credentials (https://developers.expediagroup.com/rapid). Optional.
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_BASE_URL=https://test.ean.com
# U.S. EIA open data key (free: https://www.eia.gov/opendata/register.php). Optional.
EIA_API_KEY=
RATE_LIMIT_PER_MINUTE=120
